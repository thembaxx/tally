# Public canonical origin. Keep this set to the primary domain in all environments.
# Vercel preview deployments remain noindex and canonicalize to this origin.
NEXT_PUBLIC_SITE_URL=https://tally-wine-alpha.vercel.app

# Optional encrypted progress sync. The publishable key is not a service-role key.
# Apply supabase/migrations before enabling. See docs/progress-sync.md.
TALLY_SYNC_URL=
TALLY_SYNC_PUBLISHABLE_KEY=
